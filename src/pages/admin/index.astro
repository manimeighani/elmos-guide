    <script is:inline>
      (function () {
        const fab = document.getElementById('elmos-studio-fab');
        const hoverBtn = document.getElementById('elmos-hover-edit-btn');
        const modal = document.getElementById('elmos-studio-modal');
        const canvas = document.getElementById('es-canvas');
        const ctx = canvas.getContext('2d');
        const emptyBox = document.getElementById('es-empty');
        const fileInput = document.getElementById('es-file-input');
        const colorPicker = document.getElementById('es-color-picker');
        const sizeSlider = document.getElementById('es-size');
        const undoBtn = document.getElementById('es-undo');
        const resetBtn = document.getElementById('es-reset');
        const textBar = document.getElementById('es-text-bar');
        const textInput = document.getElementById('es-text-input');
        const textBgCheck = document.getElementById('es-text-bg');
        const cropBar = document.getElementById('es-crop-bar');
        const applyCropBtn = document.getElementById('es-apply-crop');
        const cancelCropBtn = document.getElementById('es-cancel-crop');
        const statusEl = document.getElementById('es-status');
        const dimsEl = document.getElementById('es-dims');
        const pageImgsWrap = document.getElementById('es-page-imgs-wrap');
        const pageImgsBox = document.getElementById('es-page-imgs');

        let tool = 'arrow';
        let color = '#ef4444';
        let size = 5;
        let history = [];
        let isDrawing = false;
        let startX = 0;
        let startY = 0;
        let cropRect = null;
        let currentFilename = 'edited-image.png';
        let hoveredSrc = null;

        function setStatus(msg) {
          statusEl.textContent = msg;
        }

        function updateDims() {
          dimsEl.textContent = canvas.width ? `${canvas.width} × ${canvas.height} px` : '';
        }

        function cloneCanvas(srcCanvas) {
          const c = document.createElement('canvas');
          c.width = srcCanvas.width;
          c.height = srcCanvas.height;
          c.getContext('2d').drawImage(srcCanvas, 0, 0);
          return { w: c.width, h: c.height, canvas: c };
        }

        function pushSnapshot() {
          history.push(cloneCanvas(canvas));
          if (history.length > 25) history.shift();
          undoBtn.disabled = history.length <= 1;
          updateDims();
        }

        function restoreSnapshot(snap) {
          if (!snap) return;
          canvas.width = snap.w;
          canvas.height = snap.h;
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          ctx.drawImage(snap.canvas, 0, 0);
          updateDims();
        }

        function loadImageFromSrc(src, filename) {
          const img = new Image();
          img.crossOrigin = 'anonymous';
          img.onload = () => {
            const maxDim = 2000;
            let w = img.naturalWidth;
            let h = img.naturalHeight;
            if (w > maxDim || h > maxDim) {
              const ratio = Math.min(maxDim / w, maxDim / h);
              w = Math.round(w * ratio);
              h = Math.round(h * ratio);
            }
            canvas.width = w;
            canvas.height = h;
            ctx.clearRect(0, 0, w, h);
            ctx.drawImage(img, 0, 0, w, h);
            history = [];
            cropRect = null;
            pushSnapshot();
            emptyBox.style.display = 'none';
            canvas.style.display = 'block';
            currentFilename = filename || 'elmos-edited-' + Date.now() + '.png';
            setStatus('عکس بارگذاری شد. ابزار دلخواه را انتخاب و روی عکس بکشید.');
          };
          img.onerror = () => {
            setStatus('خطا در خواندن عکس (محدودیت امنیتی سرور عکس). عکس را ذخیره کرده و با دکمه «انتخاب عکس جدید» باز کنید.');
          };
          img.src = src;
        }

        function refreshPageImages() {
          const imgs = Array.from(document.querySelectorAll('#nc-root img')).filter((img) => {
            if (img.closest('header')) return false;
            const r = img.getBoundingClientRect();
            return img.src && r.width >= 60 && r.height >= 45;
          });
          const unique = [...new Set(imgs.map((i) => i.src))].slice(0, 12);
          pageImgsBox.innerHTML = '';
          if (unique.length) {
            pageImgsWrap.style.display = 'block';
            unique.forEach((src) => {
              const thumb = document.createElement('img');
              thumb.src = src;
              thumb.title = 'برای ویرایش این عکس کلیک کنید';
              thumb.addEventListener('click', () => loadImageFromSrc(src));
              pageImgsBox.appendChild(thumb);
            });
          } else {
            pageImgsWrap.style.display = 'none';
          }
        }

        function openStudio(optionalSrc) {
          modal.classList.add('is-open');
          modal.setAttribute('aria-hidden', 'false');
          refreshPageImages();
          if (optionalSrc) {
            loadImageFromSrc(optionalSrc);
          }
        }

        function closeStudio() {
          modal.classList.remove('is-open');
          modal.setAttribute('aria-hidden', 'true');
        }

        fab.addEventListener('click', () => openStudio());
        document.getElementById('es-close').addEventListener('click', closeStudio);

        // دکمه شناور ویرایش روی عکس‌های آپلودشده در پنل ادمین (بدون دستکاری DOM ری‌اکت)
        document.addEventListener('mouseover', (e) => {
          if (modal.classList.contains('is-open')) return;
          const target = e.target;
          if (target === hoverBtn) return;
          if (target && target.tagName === 'IMG' && target.closest('#nc-root') && !target.closest('header')) {
            const r = target.getBoundingClientRect();
            if (r.width >= 75 && r.height >= 55 && target.src) {
              hoveredSrc = target.src;
              hoverBtn.style.top = Math.max(8, r.top + 8) + 'px';
              hoverBtn.style.left = Math.max(8, r.left + 8) + 'px';
              hoverBtn.style.display = 'inline-flex';
              return;
            }
          }
          if (!target || !target.closest('#elmos-hover-edit-btn')) {
            hoverBtn.style.display = 'none';
          }
        });

        hoverBtn.addEventListener('click', () => {
          hoverBtn.style.display = 'none';
          if (hoveredSrc) openStudio(hoveredSrc);
        });

        // آپلود فایل از سیستم
        fileInput.addEventListener('change', (e) => {
          const file = e.target.files && e.target.files[0];
          if (!file) return;
          const reader = new FileReader();
          reader.onload = () => loadImageFromSrc(reader.result, file.name.replace(/\.[^.]+$/, '') + '-edited.png');
          reader.readAsDataURL(file);
          fileInput.value = '';
        });

        // پیست کردن عکس با Ctrl+V داخل استودیو
        document.addEventListener('paste', (e) => {
          if (!modal.classList.contains('is-open')) return;
          const items = e.clipboardData && e.clipboardData.items;
          if (!items) return;
          for (const item of items) {
            if (item.type.startsWith('image/')) {
              const file = item.getAsFile();
              const reader = new FileReader();
              reader.onload = () => loadImageFromSrc(reader.result, 'pasted-' + Date.now() + '.png');
              reader.readAsDataURL(file);
              break;
            }
          }
        });

        // انتخاب ابزارها
        document.querySelectorAll('.es-tool[data-tool]').forEach((btn) => {
          btn.addEventListener('click', () => {
            if (cropRect && history.length) {
              restoreSnapshot(history[history.length - 1]);
              cropRect = null;
            }
            tool = btn.dataset.tool;
            document.querySelectorAll('.es-tool[data-tool]').forEach((b) => b.classList.remove('is-active'));
            btn.classList.add('is-active');
            textBar.classList.toggle('is-visible', tool === 'text');
            cropBar.classList.toggle('is-visible', tool === 'crop');
            if (tool === 'text') textInput.focus();
          });
        });

        // انتخاب رنگ
        function setColor(c) {
          color = c;
          colorPicker.value = c;
          document.querySelectorAll('.es-swatch').forEach((s) => {
            s.classList.toggle('is-active', s.dataset.color.toLowerCase() === c.toLowerCase());
          });
        }
        document.querySelectorAll('.es-swatch').forEach((sw) => {
          sw.addEventListener('click', () => setColor(sw.dataset.color));
        });
        colorPicker.addEventListener('input', (e) => setColor(e.target.value));
        sizeSlider.addEventListener('input', (e) => { size = Number(e.target.value); });

        // بازگشت و بازنشانی
        undoBtn.addEventListener('click', () => {
          if (history.length <= 1) return;
          history.pop();
          cropRect = null;
          restoreSnapshot(history[history.length - 1]);
          undoBtn.disabled = history.length <= 1;
        });

        resetBtn.addEventListener('click', () => {
          if (!history.length) return;
          const first = history[0];
          history = [first];
          cropRect = null;
          restoreSnapshot(first);
          undoBtn.disabled = true;
        });

        function getPos(e) {
          const rect = canvas.getBoundingClientRect();
          const scaleX = canvas.width / rect.width;
          const scaleY = canvas.height / rect.height;
          return {
            x: (e.clientX - rect.left) * scaleX,
            y: (e.clientY - rect.top) * scaleY,
          };
        }

        function drawArrow(x1, y1, x2, y2, strokeW) {
          const angle = Math.atan2(y2 - y1, x2 - x1);
          const headLen = Math.max(16, strokeW * 4.2);
          ctx.strokeStyle = color;
          ctx.fillStyle = color;
          ctx.lineWidth = strokeW;
          ctx.lineCap = 'round';

          ctx.beginPath();
          ctx.moveTo(x1, y1);
          ctx.lineTo(x2 - headLen * 0.6 * Math.cos(angle), y2 - headLen * 0.6 * Math.sin(angle));
          ctx.stroke();

          ctx.beginPath();
          ctx.moveTo(x2, y2);
          ctx.lineTo(x2 - headLen * Math.cos(angle - Math.PI / 6), y2 - headLen * Math.sin(angle - Math.PI / 6));
          ctx.lineTo(x2 - headLen * Math.cos(angle + Math.PI / 6), y2 - headLen * Math.sin(angle + Math.PI / 6));
          ctx.closePath();
          ctx.fill();
        }

        function drawCropOverlay(r) {
          ctx.save();
          ctx.fillStyle = 'rgba(8, 22, 36, 0.58)';
          ctx.fillRect(0, 0, canvas.width, r.y);
          ctx.fillRect(0, r.y + r.h, canvas.width, canvas.height - (r.y + r.h));
          ctx.fillRect(0, r.y, r.x, r.h);
          ctx.fillRect(r.x + r.w, r.y, canvas.width - (r.x + r.w), r.h);

          ctx.strokeStyle = '#00A3A0';
          ctx.lineWidth = Math.max(2, canvas.width / 350);
          ctx.setLineDash([8, 6]);
          ctx.strokeRect(r.x, r.y, r.w, r.h);
          ctx.restore();
        }

        function stampText(x, y) {
          const txt = textInput.value.trim();
          if (!txt) {
            textInput.focus();
            setStatus('ابتدا متن مورد نظر را در کادر بالا بنویسید و سپس روی عکس کلیک کنید.');
            return;
          }
          const scaleFactor = Math.max(1, canvas.width / 850);
          const fontSize = Math.round((size * 4 + 14) * scaleFactor);
          ctx.save();
          ctx.font = `700 ${fontSize}px Vazirmatn, sans-serif`;
          ctx.direction = 'rtl';
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';

          if (textBgCheck.checked) {
            const metrics = ctx.measureText(txt);
            const padX = fontSize * 0.55;
            const padY = fontSize * 0.35;
            const boxW = metrics.width + padX * 2;
            const boxH = fontSize * 1.35 + padY;
            const rx = x - boxW / 2;
            const ry = y - boxH / 2;
            const isDarkText = color.toLowerCase() === '#0b243b' || color.toLowerCase() === '#000000';
            ctx.fillStyle = isDarkText ? 'rgba(255, 255, 255, 0.88)' : 'rgba(11, 36, 59, 0.82)';
            ctx.beginPath();
            ctx.roundRect(rx, ry, boxW, boxH, 10 * scaleFactor);
            ctx.fill();
          }

          ctx.fillStyle = color;
          ctx.fillText(txt, x, y);
          ctx.restore();
          pushSnapshot();
          setStatus('متن روی عکس ثبت شد.');
        }

        canvas.addEventListener('pointerdown', (e) => {
          if (!history.length) return;
          const pos = getPos(e);
          if (tool === 'text') {
            stampText(pos.x, pos.y);
            return;
          }
          canvas.setPointerCapture(e.pointerId);
          isDrawing = true;
          startX = pos.x;
          startY = pos.y;

          if (tool === 'pen') {
            const strokeW = Math.max(2, size * Math.max(1, canvas.width / 900));
            ctx.strokeStyle = color;
            ctx.lineWidth = strokeW;
            ctx.lineCap = 'round';
            ctx.lineJoin = 'round';
            ctx.beginPath();
            ctx.moveTo(startX, startY);
          }
        });

        canvas.addEventListener('pointermove', (e) => {
          if (!isDrawing) return;
          const pos = getPos(e);
          const strokeW = Math.max(2, size * Math.max(1, canvas.width / 900));

          if (tool === 'pen') {
            ctx.lineTo(pos.x, pos.y);
            ctx.stroke();
            return;
          }

          restoreSnapshot(history[history.length - 1]);

          if (tool === 'crop') {
            cropRect = {
              x: Math.min(startX, pos.x),
              y: Math.min(startY, pos.y),
              w: Math.abs(pos.x - startX),
              h: Math.abs(pos.y - startY),
            };
            drawCropOverlay(cropRect);
          } else if (tool === 'arrow') {
            drawArrow(startX, startY, pos.x, pos.y, strokeW);
          } else if (tool === 'line') {
            ctx.strokeStyle = color;
            ctx.lineWidth = strokeW;
            ctx.lineCap = 'round';
            ctx.beginPath();
            ctx.moveTo(startX, startY);
            ctx.lineTo(pos.x, pos.y);
            ctx.stroke();
          } else if (tool === 'rect') {
            ctx.strokeStyle = color;
            ctx.lineWidth = strokeW;
            ctx.lineJoin = 'round';
            ctx.strokeRect(
              Math.min(startX, pos.x),
              Math.min(startY, pos.y),
              Math.abs(pos.x - startX),
              Math.abs(pos.y - startY)
            );
          } else if (tool === 'circle') {
            const cx = (startX + pos.x) / 2;
            const cy = (startY + pos.y) / 2;
            const rx = Math.abs(pos.x - startX) / 2;
            const ry = Math.abs(pos.y - startY) / 2;
            ctx.strokeStyle = color;
            ctx.lineWidth = strokeW;
            ctx.beginPath();
            ctx.ellipse(cx, cy, rx, ry, 0, 0, Math.PI * 2);
            ctx.stroke();
          }
        });

        canvas.addEventListener('pointerup', () => {
          if (!isDrawing) return;
          isDrawing = false;
          if (tool !== 'crop') {
            pushSnapshot();
          }
        });

        // اعمال و لغو برش (Crop)
        applyCropBtn.addEventListener('click', () => {
          if (!cropRect || cropRect.w < 10 || cropRect.h < 10) {
            setStatus('ابتدا با کشیدن روی عکس ناحیه برش را مشخص کنید.');
            return;
          }
          const base = history[history.length - 1];
          const cw = Math.round(cropRect.w);
          const ch = Math.round(cropRect.h);
          const cx = Math.round(cropRect.x);
          const cy = Math.round(cropRect.y);

          canvas.width = cw;
          canvas.height = ch;
          ctx.clearRect(0, 0, cw, ch);
          ctx.drawImage(base.canvas, cx, cy, cw, ch, 0, 0, cw, ch);
          cropRect = null;
          pushSnapshot();
          setStatus('برش با موفقیت اعمال شد.');
        });

        cancelCropBtn.addEventListener('click', () => {
          if (!history.length) return;
          cropRect = null;
          restoreSnapshot(history[history.length - 1]);
        });

        // دانلود PNG
        function downloadCanvas() {
          if (!history.length) return;
          if (cropRect) restoreSnapshot(history[history.length - 1]);
          const link = document.createElement('a');
          link.download = currentFilename;
          link.href = canvas.toDataURL('image/png');
          link.click();
          setStatus('فایل عکس ویرایش‌شده با نام ' + currentFilename + ' دانلود شد.');
        }
        document.getElementById('es-download').addEventListener('click', downloadCanvas);

        // ارسال مستقیم به کتابخانه رسانه پنل ادمین (در صورت باز بودن)
        document.getElementById('es-send-cms').addEventListener('click', () => {
          if (!history.length) return;
          if (cropRect) restoreSnapshot(history[history.length - 1]);

          canvas.toBlob((blob) => {
            if (!blob) return;
            const file = new File([blob], currentFilename, { type: 'image/png' });
            const cmsInput = document.querySelector('#nc-root input[type="file"]');

            if (cmsInput) {
              const dt = new DataTransfer();
              dt.items.add(file);
              cmsInput.files = dt.files;
              cmsInput.dispatchEvent(new Event('change', { bubbles: true }));
              closeStudio();
            } else {
              downloadCanvas();
              setStatus('کتابخانه رسانه باز نبود، بنابراین عکس دانلود شد؛ از بخش درج تصویر آن را آپلود کنید.');
            }
          }, 'image/png');
        });
      })();
    </script>
  </body>
</html>