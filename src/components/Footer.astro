---
import DefaultFooter from '@astrojs/starlight/components/Footer.astro';
---

<DefaultFooter {...Astro.props}><slot /></DefaultFooter>

<footer class="elmos-footer reveal-item">
  <div class="elmos-footer-inner">
    <div class="elmos-footer-header">
      <div class="elmos-footer-brand">
        <span class="elmos-footer-dot"></span>
        <div>
          <h3>پرکاربردترین لینک‌ها</h3>
          <p>دسترسی سریع به سامانه‌ها و راهنماهای اصلی دانشگاه علم و صنعت ایران</p>
        </div>
      </div>
    </div>

    <div class="elmos-footer-grid">
      <a href="/systems/golestan/" class="elmos-footer-link">
        <span class="elmos-footer-link-title">سامانه جامع گلستان</span>
        <span class="elmos-footer-link-desc">انتخاب واحد، مشاهده نمرات و امور آموزشی</span>
        <span class="elmos-footer-arrow">←</span>
      </a>

      <a href="/systems/samad/" class="elmos-footer-link">
        <span class="elmos-footer-link-title">سامانه تغذیه (سماد)</span>
        <span class="elmos-footer-link-desc">رزرو غذای سلف و مدیریت اعتبار تغذیه</span>
        <span class="elmos-footer-arrow">←</span>
      </a>

      <a href="https://vt.iust.ac.ir" target="_blank" rel="noopener noreferrer" class="elmos-footer-link">
        <span class="elmos-footer-link-title">تور مجازی ۳۶۰ درجه دانشگاه</span>
        <span class="elmos-footer-link-desc">گشت‌وگذار آنلاین در محوطه دانشگاه</span>
        <span class="elmos-footer-arrow">↗</span>
      </a>

      <a href="/education/course-registration/" class="elmos-footer-link">
        <span class="elmos-footer-link-title">انتخاب واحد و پیشنهادات</span>
        <span class="elmos-footer-link-desc">نکات کلیدی پیش از اولین انتخاب واحد</span>
        <span class="elmos-footer-arrow">←</span>
      </a>
    </div>

    <div class="elmos-footer-bottom">
      <span>راهنمای جامع علم و صنعت | ElmosGuide</span>
      <span>ویژه دانشجویان جدیدالورود دانشگاه علم و صنعت ایران</span>
    </div>
  </div>
</footer>

<script>
  function initPageEnhancements() {
    // علامت‌گذاری صفحات داخلی برای کوچک‌سازی هوشمند عنوان در موبایل
    const hasSidebar = Boolean(document.querySelector('.sidebar-pane'));
    document.documentElement.classList.toggle('elmos-inner-page', hasSidebar);

    // انیمیشن ظاهر شدن محتوا هنگام اسکرول
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const targets = document.querySelectorAll(
      '.hero, .elmos-section-header, .elmos-card, .elmos-inline-toc, .sl-markdown-content > h2, .sl-markdown-content > h3, .sl-markdown-content > p, .sl-markdown-content > ul, .sl-markdown-content > ol, .sl-markdown-content > table, .sl-markdown-content > .starlight-aside, .sl-markdown-content > .system-btn-group, .sl-markdown-content > .video-container, .pagination-links, .elmos-footer'
    );

    if (prefersReduced || !('IntersectionObserver' in window)) {
      targets.forEach((el) => el.classList.add('is-visible'));
      return;
    }

    targets.forEach((el, index) => {
      el.classList.add('reveal-item');
      if (el.classList.contains('elmos-card')) {
        (el as HTMLElement).style.transitionDelay = `${(index % 4) * 85}ms`;
      }
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.08,
        rootMargin: '0px 0px -30px 0px',
      }
    );

    targets.forEach((el) => observer.observe(el));
  }

  initPageEnhancements();
  document.addEventListener('astro:after-swap', initPageEnhancements);
</script>