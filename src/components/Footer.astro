---
import DefaultFooter from '@astrojs/starlight/components/Footer.astro';

const quickLinks = [
  {
    title: 'سایت اصلی دانشگاه (تور مجازی)',
    desc: 'ورود به پورتال رسمی دانشگاه علم و صنعت ایران',
    href: 'https://iust.ac.ir',
  },
  {
    title: 'سامانه جامع گلستان',
    desc: 'انتخاب واحد، برنامه هفتگی، کارنامه و امور آموزشی',
    href: 'https://golestan.iust.ac.ir',
  },
  {
    title: 'سامانه تغذیه سماد',
    desc: 'رزرو غذا، افزایش اعتبار و مدیریت ژتون سلف',
    href: 'https://samad.app',
  },
  {
    title: 'سامانه آی‌تی‌اس (ITS)',
    desc: 'اینترنت دانشگاه، ایمیل دانشجویی و پشتیبانی فنی',
    href: 'https://its.iust.ac.ir',
  },
];
---

<DefaultFooter {...Astro.props} />

<footer class="elmos-footer">
  <div class="elmos-footer-inner">
    <div class="elmos-footer-header">
      <div class="elmos-footer-brand">
        <span class="elmos-footer-dot" aria-hidden="true"></span>
        <div>
          <h3>پرکاربردترین لینک‌ها</h3>
          <p>دسترسی سریع به سامانه‌ها و پورتال‌های رسمی دانشگاه علم و صنعت ایران</p>
        </div>
      </div>

      <a
        href="https://iust.ac.ir"
        target="_blank"
        rel="noopener noreferrer"
        class="elmos-footer-logo-link"
        aria-label="دانشگاه علم و صنعت ایران"
      >
        <img
          src="/footerlogo.jpg"
          alt="لوگوی دانشگاه علم و صنعت ایران"
          class="elmos-footer-logo"
          loading="lazy"
          decoding="async"
        />
      </a>
    </div>

    <div class="elmos-footer-grid">
      {quickLinks.map((item) => (
        <a
          href={item.href}
          target="_blank"
          rel="noopener noreferrer"
          class="elmos-footer-link"
        >
          <span class="elmos-footer-arrow" aria-hidden="true">↗</span>
          <span class="elmos-footer-link-title">{item.title}</span>
          <span class="elmos-footer-link-desc">{item.desc}</span>
        </a>
      ))}
    </div>

    <div class="elmos-footer-bottom">
      <span>تقدیم به دانشجویان دانشگاه علم و صنعت</span>
      <span>راهنمای جامع علم و صنعت (ElmosGuide)</span>
    </div>
  </div>
</footer>

<script>
  function makeFooterLogoTransparent() {
    const imgs = document.querySelectorAll<HTMLImageElement>('img.elmos-footer-logo');
    imgs.forEach((img) => {
      if (img.dataset.bgProcessed === 'true') return;

      const process = () => {
        try {
          const w = img.naturalWidth;
          const h = img.naturalHeight;
          if (!w || !h) return;

          const canvas = document.createElement('canvas');
          canvas.width = w;
          canvas.height = h;
          const ctx = canvas.getContext('2d');
          if (!ctx) return;

          ctx.drawImage(img, 0, 0);
          const imgData = ctx.getImageData(0, 0, w, h);
          const data = imgData.data;

          // حذف نرم پس‌زمینه سفید برای هماهنگی کامل با تم روشن و تیره
          for (let i = 0; i < data.length; i += 4) {
            const r = data[i];
            const g = data[i + 1];
            const b = data[i + 2];
            const minCh = Math.min(r, g, b);
            const maxCh = Math.max(r, g, b);
            const isNearGrayWhite = maxCh - minCh < 22;

            if (isNearGrayWhite && minCh > 238) {
              data[i + 3] = 0;
            } else if (isNearGrayWhite && minCh > 205) {
              const fade = (238 - minCh) / (238 - 205);
              data[i + 3] = Math.round(data[i + 3] * fade);
            }
          }

          ctx.putImageData(imgData, 0, 0);
          img.dataset.bgProcessed = 'true';
          img.src = canvas.toDataURL('image/png');
        } catch {
          // در صورت خطا، حالت ترکیبی CSS در تم روشن فعال می‌ماند
        }
      };

      if (img.complete && img.naturalWidth > 0) {
        process();
      } else {
        img.addEventListener('load', process, { once: true });
      }
    });
  }

  makeFooterLogoTransparent();
  document.addEventListener('astro:after-swap', makeFooterLogoTransparent);
</script>