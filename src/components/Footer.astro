---
import DefaultFooter from '@astrojs/starlight/components/Footer.astro';

const quickLinks = [
  {
    title: 'تور مجازی دانشگاه علم و صنعت',
    desc: 'گشت‌وگذار تصویری ۳۶۰ درجه در محوطه و فضاهای دانشگاه',
    href: 'https://civil.iust.ac.ir/content/29837/%D8%AA%D9%88%D8%B1-%D9%85%D8%AC%D8%A7%D8%B2%DB%8C-%D8%AF%D8%A7%D9%86%D8%B4%DA%AF%D8%A7%D9%87-%D8%B9%D9%84%D9%85-%D9%88-%D8%B5%D9%86%D8%B9%D8%AA-%D8%A7%DB%8C%D8%B1%D8%A7%D9%86',
  },
  {
    title: 'سامانه جامع گلستان',
    desc: 'انتخاب واحد، برنامه هفتگی، کارنامه و امور آموزشی',
    href: 'https://golestan.iust.ac.ir',
  },
  {
    title: 'سامانه تغذیه سماد',
    desc: 'رزرو غذا، افزایش اعتبار و مدیریت ژتون سلف',
    href: 'https://samad.app',
  },
  {
    title: 'سامانه آی‌تی‌اس (ITS)',
    desc: 'اینترنت دانشگاه، ایمیل دانشجویی و پشتیبانی فنی',
    href: 'https://its.iust.ac.ir',
  },
];
---

<DefaultFooter {...Astro.props} />

<footer class="elmos-footer">
  <div class="elmos-footer-inner">
    <div class="elmos-footer-header">
      <div class="elmos-footer-brand">
        <span class="elmos-footer-dot" aria-hidden="true"></span>
        <div>
          <h3>پرکاربردترین لینک‌ها</h3>
          <p>دسترسی سریع به سامانه‌ها و پورتال‌های رسمی دانشگاه علم و صنعت ایران</p>
        </div>
      </div>

      <div class="elmos-footer-logo-box" aria-label="لوگوی دانشگاه علم و صنعت ایران"></div>
    </div>

    <div class="elmos-footer-grid">
      {quickLinks.map((item) => (
        <a
          href={item.href}
          target="_blank"
          rel="noopener noreferrer"
          class="elmos-footer-link"
        >
          <span class="elmos-footer-arrow" aria-hidden="true">↗</span>
          <span class="elmos-footer-link-title">{item.title}</span>
          <span class="elmos-footer-link-desc">{item.desc}</span>
        </a>
      ))}
    </div>

    <div class="elmos-footer-bottom">
      <span>تقدیم به دانشجویان دانشگاه علم و صنعت</span>
      <span>راهنمای جامع علم و صنعت (ElmosGuide)</span>
    </div>
  </div>
</footer>

<script>
  function syncFooterLogoWithHeader() {
    const box = document.querySelector('.elmos-footer-logo-box');
    if (!box) return;

    const headerImg = document.querySelector<HTMLImageElement>('header.header .site-title img');
    const headerSvg = document.querySelector<SVGElement>('header.header .site-title svg');

    if (headerImg?.getAttribute('src')) {
      let footerImg = box.querySelector<HTMLImageElement>('img.elmos-footer-logo');
      if (!footerImg) {
        footerImg = document.createElement('img');
        footerImg.className = 'elmos-footer-logo';
        box.innerHTML = '';
        box.appendChild(footerImg);
      }
      footerImg.src = headerImg.getAttribute('src')!;
      footerImg.alt = 'لوگوی دانشگاه علم و صنعت ایران';
    } else if (headerSvg && !box.querySelector('svg')) {
      const clonedSvg = headerSvg.cloneNode(true) as SVGElement;
      clonedSvg.classList.add('elmos-footer-logo');
      box.innerHTML = '';
      box.appendChild(clonedSvg);
    }
  }

  syncFooterLogoWithHeader();
  document.addEventListener('astro:after-swap', syncFooterLogoWithHeader);
</script>